App(
    appid="nfc_magic_dev",
    name="NFC Magic Dev",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="nfc_magic_app",
    # Default is ["*.c*"], globbed recursively -- that would sweep in the dev-only tools/ dir
    # (its venv + __pycache__ hold .cpython-*.pyc files that match *.c*, and future deps could ship
    # .c sources). Exclude it the same way the firmware excludes lib/.
    sources=["*.c*", "!tools"],
    requires=[
        "storage",
        "gui",
    ],
    stack_size=4 * 1024,
    fap_description="Write, clone and wipe magic NFC tags: MIFARE Gen1/2/4, USCUID-UL (Ultralight/NTAG), and ISO15693 / NfcV",
    fap_version="2.0",
    fap_icon="assets/Nfc_10px.png",
    fap_category="NFC",
    fap_icon_assets="assets",
)
